# ==========================================================
# STUDENT PERFORMANCE AND ACADEMIC INSIGHTS ANALYSIS
# Python | Pandas | NumPy | Matplotlib | Seaborn
# ==========================================================

# 1. IMPORT LIBRARIES

import pandas as pd
import numpy as np
import matplotlib.pyplot as plt
import seaborn as sns

sns.set_theme(style="whitegrid")
plt.rcParams["figure.figsize"] = (10, 6)

# 2. UPLOAD DATASET

from google.colab import files

uploaded = files.upload()

file_name = next(
    (name for name in uploaded if name.lower().endswith(".csv")),
    None
)

if file_name is None:
    raise ValueError("Please upload a CSV dataset.")

df = pd.read_csv(file_name)

print("Dataset loaded successfully!")
print("Original Shape:", df.shape)

display(df.head())


# 3. DATA UNDERSTANDING

print("\n--- Dataset Information ---")
df.info()

print("\n--- Column Names ---")
print(df.columns.tolist())

print("\n--- Statistical Summary ---")
display(df.describe(include="all"))

print("\n--- Missing Values ---")
print(df.isnull().sum())

print("\n--- Duplicate Rows ---")
print(df.duplicated().sum())


# 4. DATA CLEANING

# Remove unnecessary index columns
df.drop(
    columns=[col for col in df.columns if str(col).startswith("Unnamed:")],
    inplace=True,
    errors="ignore"
)

# Remove duplicate records
df.drop_duplicates(inplace=True)

# Remove extra spaces from column names
df.columns = df.columns.astype(str).str.strip()

# Clean text columns
for col in df.select_dtypes(include="object").columns:
    df[col] = df[col].astype("string").str.strip()
    df[col] = df[col].replace("", pd.NA)

# Convert numerical columns
numeric_columns = [
    "NrSiblings",
    "MathScore",
    "ReadingScore",
    "WritingScore"
]

for col in numeric_columns:
    if col in df.columns:
        df[col] = pd.to_numeric(df[col], errors="coerce")

# Fill missing categorical values with mode
categorical_columns = df.select_dtypes(
    include=["object", "string"]
).columns

for col in categorical_columns:
    if df[col].isnull().any():
        mode_value = df[col].mode()

        if not mode_value.empty:
            df[col] = df[col].fillna(mode_value.iloc[0])

# Fill missing numerical values with median
for col in numeric_columns:
    if col in df.columns and df[col].isnull().any():
        df[col] = df[col].fillna(df[col].median())

# Remove records with missing subject scores
score_columns = ["MathScore", "ReadingScore", "WritingScore"]

df.dropna(subset=score_columns, inplace=True)

print("\nData cleaning completed!")

print("Shape after cleaning:", df.shape)

print("\nMissing values after cleaning:")
print(df.isnull().sum())

print("\nDuplicate rows after cleaning:")
print(df.duplicated().sum())


# 5. RENAME COLUMNS

df.rename(columns={
    "Gender": "gender",
    "EthnicGroup": "ethnic_group",
    "ParentEduc": "parent_education",
    "LunchType": "lunch_type",
    "TestPrep": "test_preparation",
    "ParentMaritalStatus": "parent_marital_status",
    "PracticeSport": "practice_sport",
    "IsFirstChild": "is_first_child",
    "NrSiblings": "number_of_siblings",
    "TransportMeans": "transport",
    "WklyStudyHours": "weekly_study_hours",
    "MathScore": "math_score",
    "ReadingScore": "reading_score",
    "WritingScore": "writing_score"
}, inplace=True)


# 6. CREATE NEW COLUMNS

df["total_score"] = (
    df["math_score"] +
    df["reading_score"] +
    df["writing_score"]
)

df["average_score"] = df["total_score"] / 3

df["performance_level"] = pd.cut(
    df["average_score"],
    bins=[-np.inf, 39, 59, 79, np.inf],
    labels=[
        "Needs Improvement",
        "Average",
        "Good",
        "Excellent"
    ]
)

print("\nNew columns created successfully!")

display(df.head())


# 7. KEY PERFORMANCE INDICATORS

print("\n========== KEY PERFORMANCE INDICATORS ==========")

print("Total Students:", len(df))

print("Average Math Score:",
      round(df["math_score"].mean(), 2))

print("Average Reading Score:",
      round(df["reading_score"].mean(), 2))

print("Average Writing Score:",
      round(df["writing_score"].mean(), 2))

print("Overall Average Score:",
      round(df["average_score"].mean(), 2))

print("Highest Average Score:",
      round(df["average_score"].max(), 2))

print("Lowest Average Score:",
      round(df["average_score"].min(), 2))


# 8. BUSINESS ANALYSIS QUESTIONS

# Q1. Which gender has the highest average score?

print("\nQ1. Average Score by Gender")

display(
    df.groupby("gender", observed=True)["average_score"]
    .mean()
    .sort_values(ascending=False)
    .round(2)
)


# Q2. How does parental education affect student performance?

print("\nQ2. Average Score by Parent Education")

display(
    df.groupby("parent_education", observed=True)["average_score"]
    .mean()
    .sort_values(ascending=False)
    .round(2)
)


# Q3. Does test preparation improve student performance?

print("\nQ3. Average Score by Test Preparation")

display(
    df.groupby("test_preparation", observed=True)["average_score"]
    .mean()
    .round(2)
)


# Q4. Which ethnic group has the highest average score?

print("\nQ4. Average Score by Ethnic Group")

display(
    df.groupby("ethnic_group", observed=True)["average_score"]
    .mean()
    .sort_values(ascending=False)
    .round(2)
)


# Q5. How do weekly study hours relate to performance?

print("\nQ5. Average Score by Weekly Study Hours")

display(
    df.groupby("weekly_study_hours", observed=True)["average_score"]
    .mean()
    .round(2)
)


# Q6. Which subject has the highest average score?

print("\nQ6. Subject-wise Average Scores")

display(
    df[["math_score", "reading_score", "writing_score"]]
    .mean()
    .sort_values(ascending=False)
    .round(2)
)


# Q7. How many students belong to each performance level?

print("\nQ7. Student Performance Distribution")

display(
    df["performance_level"]
    .value_counts()
    .to_frame("student_count")
)


# Q8. What is the average score by lunch type?

print("\nQ8. Average Score by Lunch Type")

display(
    df.groupby("lunch_type", observed=True)["average_score"]
    .mean()
    .round(2)
)


# Q9. Does sports participation relate to student performance?

print("\nQ9. Average Score by Sports Participation")

display(
    df.groupby("practice_sport", observed=True)["average_score"]
    .mean()
    .round(2)
)


# 9. DATA VISUALISATION

# Chart 1: Gender-wise Performance

plt.figure(figsize=(8, 5))

sns.barplot(
    data=df,
    x="gender",
    y="average_score",
    errorbar=None
)

plt.title("Average Student Score by Gender")
plt.xlabel("Gender")
plt.ylabel("Average Score")
plt.tight_layout()
plt.show()


# Chart 2: Parent Education and Performance

plt.figure(figsize=(11, 5))

sns.barplot(
    data=df,
    x="parent_education",
    y="average_score",
    errorbar=None
)

plt.title("Student Performance by Parent Education")
plt.xlabel("Parent Education")
plt.ylabel("Average Score")
plt.xticks(rotation=25)
plt.tight_layout()
plt.show()


# Chart 3: Test Preparation and Performance

plt.figure(figsize=(8, 5))

sns.barplot(
    data=df,
    x="test_preparation",
    y="average_score",
    errorbar=None
)

plt.title("Test Preparation vs Student Performance")
plt.xlabel("Test Preparation")
plt.ylabel("Average Score")
plt.tight_layout()
plt.show()


# Chart 4: Subject-wise Performance

subject_average = df[
    ["math_score", "reading_score", "writing_score"]
].mean()

subject_average.plot(
    kind="bar",
    figsize=(8, 5)
)

plt.title("Average Score Across Subjects")
plt.xlabel("Subjects")
plt.ylabel("Average Score")
plt.xticks(rotation=0)
plt.tight_layout()
plt.show()


# Chart 5: Score Distribution

plt.figure(figsize=(9, 5))

sns.histplot(
    df["average_score"],
    bins=20,
    kde=True
)

plt.title("Distribution of Student Average Scores")
plt.xlabel("Average Score")
plt.ylabel("Number of Students")
plt.tight_layout()
plt.show()


# Chart 6: Ethnic Group and Gender Performance

plt.figure(figsize=(10, 5))

sns.barplot(
    data=df,
    x="ethnic_group",
    y="average_score",
    hue="gender",
    errorbar=None
)

plt.title("Average Score by Ethnic Group and Gender")
plt.xlabel("Ethnic Group")
plt.ylabel("Average Score")
plt.tight_layout()
plt.show()


# Chart 7: Correlation Between Subject Scores

plt.figure(figsize=(7, 5))

correlation = df[
    ["math_score", "reading_score", "writing_score"]
].corr()

sns.heatmap(
    correlation,
    annot=True,
    cmap="Blues",
    fmt=".2f"
)

plt.title("Correlation Between Subject Scores")
plt.tight_layout()
plt.show()


# Chart 8: Performance Level Distribution

plt.figure(figsize=(9, 5))

sns.countplot(
    data=df,
    x="performance_level",
    order=[
        "Needs Improvement",
        "Average",
        "Good",
        "Excellent"
    ]
)

plt.title("Student Performance Level Distribution")
plt.xlabel("Performance Level")
plt.ylabel("Number of Students")
plt.xticks(rotation=15)
plt.tight_layout()
plt.show()


# 10. FINAL DATASET CHECK

print("\n========== FINAL DATASET ==========")

print("Final Rows and Columns:", df.shape)

print("\nFinal Column Names:")
print(df.columns.tolist())

print("\nFinal Missing Values:")
print(df.isnull().sum())

display(df.head(10))


# 11. EXPORT CLEANED DATASET

output_file = "student_performance_cleaned.csv"

df.to_csv(output_file, index=False)

print("\nCleaned dataset exported successfully!")

files.download(output_file)


# ==========================================================
# PROJECT COMPLETED
